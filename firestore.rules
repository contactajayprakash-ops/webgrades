rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Agenda sync. The document id is a SHA-256 of the student's HAC
    // username+password, so it can't be reached without the login. The app has
    // no Firebase Auth, so we permit get/write on a *known* id but forbid
    // enumeration (list) and constrain the document to the expected shape/size.
    match /agendas/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if request.resource.data.keys().hasOnly(['tasks', 'updatedAt', 'v'])
                   && request.resource.data.tasks is list
                   && request.resource.data.tasks.size() <= 1000
                   && request.resource.data.updatedAt is number;
    }

    // Settings sync (appearance + GPA setup). Same doc-id-as-secret model.
    match /settings/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if request.resource.data.keys().hasOnly(['data', 'updatedAt', 'v'])
                   && request.resource.data.updatedAt is number
                   && request.resource.data.data is map;
    }

    // Server-side grade snapshots. The Pi is the ONLY writer (Firebase Admin SDK,
    // which bypasses these rules); the browser only reads its own doc by the
    // credential-hash id. So: get on a known id, no enumeration, and NO client
    // write path at all.
    match /grades/{id} {
      allow get: if true;      // doc id is the SHA-256 of username+password
      allow list: if false;    // no enumeration
      allow write: if false;   // only the Pi writes, via the Admin SDK
    }

    // Nothing else is accessible.
    match /{document=**} { allow read, write: if false; }
  }
}
